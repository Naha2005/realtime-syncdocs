# Server Configuration
PORT=5000
NODE_ENV=development

# Security (Replace with a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here

# Frontend Client URL (For CORS and WebSocket origins)
CLIENT_URL=http://localhost:5173

# Database (Optional: falls back to in-memory DB if omitted or unreachable)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/collabdocs?retryWrites=true&w=majority
